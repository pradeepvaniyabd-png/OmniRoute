# =============================================================================
#  All-in-One Trading Super-Terminal — configuration template
#  Copy to .env (run_terminal.bat does this automatically) and fill in values.
#  Keep comments on their own lines (no inline comments after values).
# =============================================================================

# ------------------------------- BROKER --------------------------------------
# paper = simulated fills on public market data (safe forward-testing)
# mt5   = live/demo account through the MetaTrader 5 terminal (Windows only)
BROKER_MODE=paper

# MetaTrader 5 credentials (leave blank to attach to the terminal's logged-in account)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# e.g. C:\Program Files\MetaTrader 5\terminal64.exe  (blank = auto-detect running terminal)
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=60000
MT5_PORTABLE=false
# Broker server clock vs UTC: auto | ny_close (UTC+2 winter / UTC+3 summer) | hours e.g. 2
MT5_SERVER_UTC_OFFSET=auto
MAGIC_NUMBER=770077
MAX_DEVIATION_POINTS=20
# Broker symbol names, e.g. XAUUSD=XAUUSDm,BTCUSD=BTCUSDm  (or set a common suffix)
SYMBOL_MAP=
SYMBOL_SUFFIX=

# ------------------------- SYMBOLS & TIMEFRAMES ------------------------------
SYMBOLS=XAUUSD,BTCUSD,EURUSD,GBPUSD
HTF_TIMEFRAME=H1
MTF_TIMEFRAME=M15
LTF_TIMEFRAME=M5
LTF_BARS=500
MTF_BARS=400
HTF_BARS=400
SCAN_INTERVAL_SECONDS=10
PROTECTOR_INTERVAL_SECONDS=1
NEWS_LOOP_SECONDS=20
# auto = execute trades | signal_only = broadcast A+ setups without placing orders
EXECUTION_MODE=auto
# Start the bot in RUNNING state on launch (default: PAUSED until you press Start)
AUTO_START_BOT=false

# --------------------------------- RISK --------------------------------------
RISK_PERCENT=1.0
MAX_RISK_PERCENT=2.0
MAX_DAILY_LOSS_PERCENT=3.0
DAILY_RESET_TIMEZONE=Asia/Kolkata
DAILY_RESET_HOUR=0
# equity | balance | max  (reference value at the start of the trading day)
DAILY_LOSS_REFERENCE=equity
# all = close every position on the account when the breaker trips | bot = only this bot's magic
CIRCUIT_BREAKER_SCOPE=all
CIRCUIT_BREAKER_ALERT_CHANNEL=true
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_DAY=6
ALLOW_HEDGING=false
LOSS_COOLDOWN_MINUTES=30
# Allow the broker minimum lot when the calculated lot is smaller (only if it stays <= MAX_RISK_PERCENT)
ALLOW_MIN_LOT_OVERRIDE=false
TP1_RR=1.5
TP2_RR=3.0
# Percent of the position closed at TP1 (0 = only notify + breakeven)
TP1_CLOSE_PERCENT=50
BREAKEVEN_TRIGGER_R=1.0
BREAKEVEN_BUFFER_POINTS=XAUUSD=30,BTCUSD=1500,EURUSD=15,GBPUSD=15
TRAILING_START_R=1.5
# atr | points | structure
TRAILING_MODE=atr
TRAILING_ATR_MULT=1.5
TRAILING_POINTS=XAUUSD=400,BTCUSD=30000,EURUSD=150,GBPUSD=150
TRAILING_MIN_STEP_ATR=0.1
MAX_SPREAD_POINTS=XAUUSD=45,BTCUSD=3500,EURUSD=20,GBPUSD=25
DEFAULT_MAX_SPREAD_POINTS=50
# Apply breakeven/trailing to positions opened manually outside the bot
MANAGE_MANUAL_POSITIONS=false

# ------------------------------- STRATEGY ------------------------------------
ENABLED_STRATEGIES=sweep_mss_fvg,order_block,time_candle_breakout
MIN_SCORE_TO_TRADE=6.5
A_PLUS_SCORE=8.0
REQUIRE_KILLZONE=true
# false = never take a setup against a clear HTF (H1) bias
ALLOW_COUNTER_HTF=false
KILLZONE_TIMEZONE=America/New_York
KILLZONES=LONDON=02:00-05:00,NY_AM=07:00-10:00,SB_LONDON=03:00-04:00,SB_NY_AM=10:00-11:00,SB_NY_PM=14:00-15:00
SESSION_RANGES=ASIA=20:00-00:00,LONDON=02:00-05:00,NEW_YORK=07:00-10:00
SWING_LEFT_BARS=2
SWING_RIGHT_BARS=2
FVG_MIN_ATR=0.15
# top = proximal edge of the FVG | ce = consequent encroachment (50%)
FVG_ENTRY=top
# proximal | mean (mean threshold of the order-block body)
OB_ENTRY=proximal
OB_LOOKBACK_BARS=10
DISPLACEMENT_ATR=1.0
SL_BUFFER_ATR=0.1
MIN_SL_ATR=0.3
MAX_SL_ATR=4.0
SETUP_LOOKBACK_BARS=36
MSS_MAX_BARS=12
SETUP_EXPIRY_BARS=12
MAX_ENTRY_DRIFT_R=1.0
EMA_PERIOD=50
ATR_PERIOD=14
VOLUME_SPIKE_MULT=1.5
CRT_TIMEFRAME=H4
# wick (classic CRT) | tbs (turtle body soup) | both
CRT_MODE=both
DXY_FILTER=true
DXY_SYMBOL=DXY
DXY_REQUIRED=false
# 8:00 PM IST (14:30 UTC) and 8:45 PM IST (15:15 UTC) candle breakout
TIME_CANDLE_TIMES_IST=20:00,20:45
TIME_CANDLE_TIMEFRAME=M15
TIME_CANDLE_VALID_MINUTES=120
# close = enter on the breakout close | retest = limit order at the broken range edge
TIME_CANDLE_ENTRY=close
# range = SL beyond the opposite edge | mid = SL beyond the range midpoint
TIME_CANDLE_SL=range

# --------------------------- FOREX FACTORY NEWS ------------------------------
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_BEFORE_MIN=15
NEWS_BLACKOUT_AFTER_MIN=15
NEWS_BLACKOUT_IMPACTS=High
# none | breakeven | close  (applied NEWS_PRE_ACTION_MINUTES before a red event)
NEWS_ACTION_ON_OPEN_POSITIONS=none
NEWS_PRE_ACTION_MINUTES=5
NEWS_WARNING_LEAD_MIN=15
NEWS_ALERT_CURRENCIES=USD,EUR,GBP,JPY
NEWS_ALERT_IMPACTS=High
NEWS_WARNING_KEYWORDS=CPI,Non-Farm,NFP,FOMC,Federal Funds,Unemployment Claims,Powell,Interest Rate,GDP,PCE,Retail Sales,ISM,ECB,BOE,BOJ,Lagarde,Bailey,Ueda
# true = only warn for keyword (tier-1) events
NEWS_WARNING_KEYWORDS_ONLY=false
NEWS_DIGEST_ENABLED=true
NEWS_DIGEST_TIME_IST=08:00
NEWS_DIGEST_GRACE_HOURS=3
# Currencies that move a symbol, e.g. US30=USD,XAUUSD=USD  (auto-derived when blank)
NEWS_CURRENCY_MAP=
FF_REFRESH_MINUTES=30
FF_JSON_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
FF_XML_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.xml
FF_HTML_URL=https://www.forexfactory.com/calendar?week=this
FF_XML_TIMEZONE=UTC
FF_HTML_TIMEZONE=America/New_York
FF_HTTP_TIMEOUT=15

# ------------------------------- TELEGRAM ------------------------------------
TELEGRAM_ENABLED=true
# From @BotFather. The bot must be an ADMIN of the channel to post.
TELEGRAM_BOT_TOKEN=
# Public channel: @your_channel   Private channel/group: -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
# Your personal chat id for admin/emergency alerts (message @userinfobot to get it)
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BRAND_NAME=Quant Super-Terminal
TELEGRAM_BROADCAST_EXECUTED=true
TELEGRAM_BROADCAST_A_PLUS=true
TELEGRAM_BROADCAST_UPDATES=true
TELEGRAM_BROADCAST_TRAIL_STEPS=false
TELEGRAM_BROADCAST_MANUAL=true
TELEGRAM_NEWS_TO_CHANNEL=true
TELEGRAM_ADMIN_NEWS_LOCK_ALERTS=true
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=20

# ---------------------------- PAPER TRADING ----------------------------------
PAPER_STARTING_BALANCE=10000
PAPER_LEVERAGE=100
PAPER_COMMISSION_PER_LOT=0
# Market data per symbol: yahoo:<ticker> or binance:<pair>
PAPER_DATA_SOURCES=XAUUSD=yahoo:GC=F,BTCUSD=binance:BTCUSDT,EURUSD=yahoo:EURUSD=X,GBPUSD=yahoo:GBPUSD=X,DXY=yahoo:DX-Y.NYB
# Simulated spread in points per symbol (defaults are built in)
PAPER_SPREAD_POINTS=
PAPER_HTTP_TIMEOUT=10

# ------------------------------ WEB TERMINAL ---------------------------------
# run_terminal.bat opens http://127.0.0.1:8800 . Keep 127.0.0.1 on a desktop PC.
WEB_HOST=127.0.0.1
WEB_PORT=8800
# Login password. REQUIRED when WEB_HOST is not 127.0.0.1 (e.g. 0.0.0.0 on a VPS).
WEB_PASSWORD=
# Optional fixed key for signing login sessions (otherwise generated in DATA_DIR)
WEB_SESSION_SECRET=
WEB_SESSION_HOURS=12
WEB_OPEN_BROWSER=true
# Only when a reverse proxy with its own authentication fronts the terminal
WEB_ALLOW_INSECURE_REMOTE=false

# --------------------------------- APP ---------------------------------------
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
UI_REFRESH_SECONDS=2
CHART_REFRESH_SECONDS=5
CHART_BARS=300
CHART_TIMEZONE=Asia/Kolkata
